# EPICS MCP Configuration
#
# These are PROCESS ENVIRONMENT VARIABLES, not a .env file: the server reads os.environ directly
# (pydantic-settings with env_prefix EPICS_MCP_, NO env_file), so nothing on disk named `.env` is
# ever loaded. Set them in whatever LAUNCHES the server, e.g. the `env` block of the MCP client's
# `.mcp.json` entry, a systemd unit, a container spec, or your shell. This file is a commented
# REFERENCE of every recognised variable and its default; copy the lines you need into that launcher.

# PV Write Safety (default: false, all writes blocked)
EPICS_MCP_ALLOW_PV_WRITE=false
# Regex allowlist. REQUIRED once ALLOW_PV_WRITE=true: an empty pattern with writes on makes the
# server refuse to start (never a silent allow-all). Use ^TEST:.*$ to scope, or .* to allow all.
# EPICS_MCP_PV_WRITE_PATTERN=^TEST:.*$
# Loopback-reach requirement: with ALLOW_PV_WRITE=true the server ALSO refuses to start unless the
# EPICS client search env (the network block below) is loopback-only, every ADDR_LIST/NAME_SERVERS
# token a loopback host AND both *_AUTO_ADDR_LIST disabled (NO). This makes "read the facility +
# write the facility" impossible at boot, not merely discouraged.
# EPICS_MCP_WRITE_RATE_LIMIT=10
# S3 read throttle: max REST reads per 60 s before the shared GET chokepoint raises RateLimitError,
# protects a facility from an unthrottled read burst. Default 0 = DISABLED (opt-in); set a
# positive value to enable. Over the limit it RAISES, never blocks (a blocking wait would hold a
# worker thread and reintroduce the monitor-starvation the K4 bulkhead removes).
# EPICS_MCP_READ_RATE_LIMIT=0
# Audit log path for write attempts. Empty/unset = stderr (ephemeral, lost on restart). REQUIRED
# once a write gate is on: a write-enabled server (ALLOW_PV_WRITE / ALLOW_OLOG_WRITE) refuses to
# start without a durable path, so the write audit trail survives a restart.
# EPICS_MCP_AUDIT_LOG_FILE=/var/log/epics-mcp/audit.log
# O3 readback verification (always-on): after a sanctioned write the value is read back and compared
# to what was written. This FALLBACK tolerance feeds BOTH the relative and absolute axis of
# math.isclose; it is used only when the record carries no usable control.min_step (> 0 is preferred,
# the IOC's own drive resolution). No on/off switch, readback is always-on so a wrong write is loud.
# EPICS_MCP_READBACK_TOLERANCE=1e-06

# p4p Provider (pva = PVAccess, ca = Channel Access; lowercase only)
# EPICS_MCP_PROVIDER=pva
# EPICS_MCP_DEFAULT_TIMEOUT=5.0
# Read/monitor limits (defaults shown).
# EPICS_MCP_MAX_BATCH_SIZE=100
# EPICS_MCP_MAX_MONITOR_DURATION=60.0
# EPICS_MCP_MAX_MONITOR_EVENTS=1000
# Dedicated monitor thread-pool width (K4 bulkhead): the max number of concurrent pv_monitor
# subscriptions. Monitors block a worker thread up to MAX_MONITOR_DURATION; running them on their own
# pool (not the shared one behind every other read/write) keeps a monitor burst from starving the
# rest of the server into an apparent hang. (>= 1)
# EPICS_MCP_MONITOR_MAX_CONCURRENCY=8

# Opt-in path boundary: os.pathsep-separated roots that file/dir tool arguments
# (displays_dir, st_cmd_path, module_db_root, file_path) must resolve under.
# Empty/unset = no boundary. Separator is ';' on Windows, ':' on Linux.
# EPICS_MCP_ALLOWED_ROOTS=/data/opi:/data/iocs

# Optional REST services (read-only; empty/unset URL = disabled, no client, NO network call).
# TLS trust for the HTTPS REST planes below. Set CA_BUNDLE to a CA-bundle PEM when a REST host uses a
# cert signed by an internal root CA not in certifi. When the planes present DIFFERENT trust roots (one
# internal CA, another a PUBLIC CA), combine the internal CA WITH the public roots (certifi's
# cacert.pem) into ONE PEM. TLS_VERIFY=false disables verification, UNLESS EPICS_MCP_CA_BUNDLE is
# set, which takes precedence and keeps verification ON (see config.py). Internal network only.
# EPICS_MCP_CA_BUNDLE=/etc/ssl/certs/combined-ca.pem
# EPICS_MCP_TLS_VERIFY=true
# ChannelFinder (PV registry): service root incl. context path.
# EPICS_MCP_CHANNELFINDER_URL=http://localhost:8080/ChannelFinder
# EPICS_MCP_CHANNELFINDER_AUTH=
# Cap on channels per CF prefix query (default 500; raise for a large device prefix).
# EPICS_MCP_CHANNELFINDER_MAX_RESULTS=500
# DS-PRIVACY allowlists deciding which ChannelFinder owner / property values are surfaced vs. redacted
# (see channelfinder_client._project). UNSET = the built-in ESS RecSync default (shown below); a
# comma-separated list OVERRIDES it (your facility's own service accounts / technical property names);
# an explicitly EMPTY value redacts EVERYTHING (empty allowlist). Set them if your registry uses
# different service accounts (RecSync populates `owner`) or technical property names.
# EPICS_MCP_CHANNELFINDER_SAFE_OWNER_ACCOUNTS=recceiver
# EPICS_MCP_CHANNELFINDER_SAFE_PROPERTY_NAMES=iocName,hostName,iocid,pvStatus,time
# EPICS Archiver Appliance (history): MGMT root (:17665, /mgmt/bpl). Activates is_archived /
# get_pv_history / get_archive_info.
# EPICS_MCP_ARCHIVER_URL=http://localhost:17665
# RETRIEVAL root (:17668, /retrieval/data), get_pv_history hits this. In a single-JVM appliance leave it
# empty (falls back to ARCHIVER_URL); in a split/multi-instance deployment mgmt and retrieval are separate ports.
# EPICS_MCP_ARCHIVER_RETRIEVAL_URL=http://localhost:17668
# EPICS_MCP_ARCHIVER_AUTH=
# Phoebus Alarm Logger: REST root. Activates is_alarm_configured + get_alarm_history.
# EPICS_MCP_ALARM_URL=http://localhost:8081
# EPICS_MCP_ALARM_AUTH=
# ESS Naming Service (device-name registered/ACTIVE lookup + typo vs. unregistered).
# Enables lookup_device_name (standalone), and the naming plane of diagnose_connection AND
# crossplane --naming. Empty/unset = disabled = withheld: NO ESS call unless set (no egress by
# default; no built-in default host). Set the service root WITHOUT a trailing /rest.
# EPICS_MCP_NAMING_URL=https://naming.example.org/
# Phoebus Olog (electronic logbook): REST root incl. context path. Activates search_logbook +
# get_log_entry + list_logbooks + list_tags. Empty/unset = disabled: NO ESS call unless set (no egress
# by default, no built-in host).
#
# OUTPUT POSTURE (ESS-spec pending, see the operator guide): DS-PRIVACY-redacted, author
# dropped, free text withheld, UNLESS BOTH of these hold:
#   1. this url is loopback (localhost / 127.0.0.0/8 / ::1), AND
#   2. EPICS_MCP_OLOG_ASSUME_TEST_DATA=true (below) declares the data synthetic.
# Then entries come back WHOLE, so a search is judgeable and a write can verify itself.
# `epics-doctor` prints the effective posture.
# EPICS_MCP_OLOG_URL=http://localhost:8080/Olog

# Your EXPLICIT declaration that the Olog above holds synthetic test data. Default false =
# always redact. Both this AND a loopback url are required, because neither proves the case
# alone: a loopback ADDRESS does not prove the DATA is synthetic (`ssh -L 8080:olog-prod:8080`
# serves production on localhost with the url unchanged), and this flag alone would not catch
# "pointed it at the facility and forgot". Only a person can assert what the data is.
# EPICS_MCP_OLOG_ASSUME_TEST_DATA=false
# EPICS_MCP_OLOG_AUTH=

# Olog logbook WRITE (create_log_entry / reply_to_log / add_log_attachment / update_log_entry),
# a SEPARATE gate; ALLOW_PV_WRITE is untouched.
# Default false = every Olog write denied. Unlike PV write (bounded by its own gate + regex
# allowlist; PV reach follows the launcher's EPICS search env, see the network block below),
# Olog speaks HTTP to any URL, so a write needs a TEST-SERVER URL boundary: it is refused unless
# OLOG_URL is a loopback host, OR its exact base URL is in the allowlist AND ALLOW_REMOTE=true. Use a
# DEDICATED service account (never a personal login, it becomes the record owner). A remote target
# MUST be https:// (a plain-http remote is REFUSED, Basic creds are cleartext). The write session is
# deliberately env-independent (no proxy / REQUESTS_CA_BUNDLE env): a remote's CA must come from
# EPICS_MCP_CA_BUNDLE, and it is not reachable through an env proxy.
EPICS_MCP_ALLOW_OLOG_WRITE=false
# EPICS_MCP_OLOG_WRITE_USER=epics-pv-logbook-svc
# EPICS_MCP_OLOG_WRITE_PASSWORD=
# Comma-separated logbook names a write may target; EMPTY + gate on = deny-all (fail-closed).
# EPICS_MCP_OLOG_WRITE_LOGBOOKS=Commissioning
# EPICS_MCP_OLOG_WRITE_RATE_LIMIT=5
# Exact base URL(s) allowed as non-loopback write targets (only with ALLOW_REMOTE=true below).
# EPICS_MCP_OLOG_WRITE_URL_ALLOWLIST=https://olog.example.org/Olog
# EPICS_MCP_OLOG_WRITE_ALLOW_REMOTE=false

# Olog ATTACHMENTS (create_log_entry / reply_to_log / add_log_attachment upload;
# download_log_attachment / list_log_attachments read).
# Upload rides the write gate above (its size is capped by MAX_BYTES; only HEIC is refused server-side).
# Raw attachment BYTES bypass the entry redaction, so a DOWNLOAD hands them back ONLY in whole-mode
# (loopback OLOG_URL + ASSUME_TEST_DATA) AND with this explicit opt-in (default false = bytes withheld;
# the by-id endpoint has no server-side per-log auth, so byte egress is a deliberate choice). Filenames
# follow whole-mode alone. Bytes cross the boundary as a workspace file path (EPICS_MCP_ALLOWED_ROOTS-
# checked) or base64 for small inline images.
# EPICS_MCP_OLOG_ALLOW_ATTACHMENT_DOWNLOAD=false
# Client-side cap on total upload bytes (checked before files are read; the server enforces its own 413).
# EPICS_MCP_OLOG_ATTACH_MAX_BYTES=52428800

# diagnose_connection live-probe timeout (fail-fast; separate from DEFAULT_TIMEOUT).
# EPICS_MCP_DIAGNOSE_TIMEOUT=5.0

# --- TEST-ONLY (not read by the server; only by the opt-in live suite) ---------------------------
# A SECOND Olog principal, distinct from EPICS_MCP_OLOG_WRITE_USER. Needed by exactly one test:
# the server re-stamps an entry's owner on every attach/update, and that is INVISIBLE when the same
# account creates and then attaches. Unset = that test skips (the rest of the live suite runs).
# A stock Phoebus Olog ships two in-memory accounts, 'user' and 'admin', use whichever is not the
# write service account.
# EPICS_MCP_OLOG_TEST_OTHER_USER=user
# EPICS_MCP_OLOG_TEST_OTHER_PASSWORD=

# EPICS Network Configuration: the PV search paths (read by p4p/pvxs, NOT EPICS_MCP_* config).
# Reach follows THIS env: the address lists (subnet broadcast), the name servers (TCP unicast,
# NOT subnet-bound), and the auto-address search, which EPICS defaults to ON when unset, an
# empty environment still broadcasts PV searches into the local subnets. For a genuinely
# localhost-isolated instance leave every list unset AND set *_AUTO_ADDR_LIST=NO explicitly;
# `epics-doctor` prints the effective posture.
# EPICS_PVA_ADDR_LIST=127.0.0.1
# EPICS_PVA_AUTO_ADDR_LIST=NO
# EPICS_PVA_NAME_SERVERS=
# EPICS_CA_ADDR_LIST=127.0.0.1
# EPICS_CA_AUTO_ADDR_LIST=NO
