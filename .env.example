# EPICS PV MCP Server Configuration
# Copy to .env and adjust values for your environment.

# PV Write Safety (default: false — all writes blocked)
EPICS_MCP_ALLOW_PV_WRITE=false
# EPICS_MCP_PV_WRITE_PATTERN=^TEST:.*$
# EPICS_MCP_WRITE_RATE_LIMIT=10
# Audit log path for write attempts (empty/unset = stderr).
# EPICS_MCP_AUDIT_LOG_FILE=

# p4p Provider (pva = PVAccess, ca = Channel Access; lowercase only)
# EPICS_MCP_PROVIDER=pva
# EPICS_MCP_DEFAULT_TIMEOUT=5.0
# Read/monitor limits (defaults shown).
# EPICS_MCP_MAX_BATCH_SIZE=100
# EPICS_MCP_MAX_MONITOR_DURATION=60.0
# EPICS_MCP_MAX_MONITOR_EVENTS=1000

# Opt-in path boundary: os.pathsep-separated roots that file/dir tool arguments
# (displays_dir, st_cmd_path, module_db_root, file_path) must resolve under.
# Empty/unset = no boundary. Separator is ';' on Windows, ':' on Linux.
# EPICS_MCP_ALLOWED_ROOTS=/data/opi:/data/iocs

# Optional REST services (read-only; empty/unset URL = disabled, no client, NO network call).
# TLS trust for the HTTPS REST planes below. Set CA_BUNDLE to a CA-bundle PEM when a REST host uses a
# cert signed by an internal root CA not in certifi. When the planes present DIFFERENT trust roots (one
# internal CA, another a PUBLIC CA), combine the internal CA WITH the public roots (certifi's
# cacert.pem) into ONE PEM. TLS_VERIFY=false disables verification entirely — internal network only.
# EPICS_MCP_CA_BUNDLE=/etc/ssl/certs/combined-ca.pem
# EPICS_MCP_TLS_VERIFY=true
# ChannelFinder (PV registry): service root incl. context path.
# EPICS_MCP_CHANNELFINDER_URL=http://localhost:8080/ChannelFinder
# EPICS_MCP_CHANNELFINDER_AUTH=
# Cap on channels per CF prefix query (default 500; raise for a large device prefix).
# EPICS_MCP_CHANNELFINDER_MAX_RESULTS=500
# DS-PRIVACY allowlists deciding which ChannelFinder owner / property values are surfaced vs. redacted
# (see channelfinder_client._project). UNSET = the built-in ESS RecSync default (shown below); a
# comma-separated list OVERRIDES it (your facility's own service accounts / technical property names);
# an explicitly EMPTY value redacts EVERYTHING (empty allowlist). Set them if your registry uses
# different service accounts (RecSync populates `owner`) or technical property names.
# EPICS_MCP_CHANNELFINDER_SAFE_OWNER_ACCOUNTS=recceiver
# EPICS_MCP_CHANNELFINDER_SAFE_PROPERTY_NAMES=iocName,hostName,iocid,pvStatus,time
# EPICS Archiver Appliance (history): MGMT root (:17665, /mgmt/bpl). Activates is_archived /
# get_pv_history / get_archive_info.
# EPICS_MCP_ARCHIVER_URL=http://localhost:17665
# RETRIEVAL root (:17668, /retrieval/data) — get_pv_history hits this. In a single-JVM appliance leave it
# empty (falls back to ARCHIVER_URL); in a split/multi-instance deployment mgmt and retrieval are separate ports.
# EPICS_MCP_ARCHIVER_RETRIEVAL_URL=http://localhost:17668
# EPICS_MCP_ARCHIVER_AUTH=
# Phoebus Alarm Logger: REST root. Activates is_alarm_configured + get_alarm_history.
# EPICS_MCP_ALARM_URL=http://localhost:8081
# EPICS_MCP_ALARM_AUTH=
# ESS Naming Service (device-name registered/ACTIVE lookup + typo vs. unregistered).
# Enables lookup_device_name (standalone), and the naming plane of diagnose_connection AND
# crossplane --naming. Empty/unset = disabled = withheld: NO ESS call unless set (no egress by
# default; no built-in default host). Set the service root WITHOUT a trailing /rest.
# EPICS_MCP_NAMING_URL=https://naming.example.org/
# Phoebus Olog (electronic logbook): REST root incl. context path. Activates search_logbook +
# get_log_entry + list_logbooks + list_tags. Empty/unset = disabled: NO ESS call unless set (no egress
# by default, no built-in host). Output is DS-PRIVACY-redacted (author dropped, free text withheld).
# EPICS_MCP_OLOG_URL=http://localhost:8080/Olog
# EPICS_MCP_OLOG_AUTH=

# Olog logbook WRITE (create_log_entry / reply_to_log) — a SEPARATE gate; ALLOW_PV_WRITE is untouched.
# Default false = every Olog write denied. Unlike PV write (localhost-isolated by the address list),
# Olog speaks HTTP to any URL, so a write needs a TEST-SERVER URL boundary: it is refused unless
# OLOG_URL is a loopback host, OR its exact base URL is in the allowlist AND ALLOW_REMOTE=true. Use a
# DEDICATED service account (never a personal login — it becomes the record owner). The remote path
# should use https:// (Basic creds are cleartext otherwise).
EPICS_MCP_ALLOW_OLOG_WRITE=false
# EPICS_MCP_OLOG_WRITE_USER=epics-pv-logbook-svc
# EPICS_MCP_OLOG_WRITE_PASSWORD=
# Comma-separated logbook names a write may target; EMPTY + gate on = deny-all (fail-closed).
# EPICS_MCP_OLOG_WRITE_LOGBOOKS=Commissioning
# EPICS_MCP_OLOG_WRITE_RATE_LIMIT=5
# Exact base URL(s) allowed as non-loopback write targets (only with ALLOW_REMOTE=true below).
# EPICS_MCP_OLOG_WRITE_URL_ALLOWLIST=https://olog.example.org/Olog
# EPICS_MCP_OLOG_WRITE_ALLOW_REMOTE=false

# diagnose_connection live-probe timeout (fail-fast; separate from DEFAULT_TIMEOUT).
# EPICS_MCP_DIAGNOSE_TIMEOUT=5.0

# EPICS Network Configuration
# EPICS_PVA_ADDR_LIST=127.0.0.1
# EPICS_CA_ADDR_LIST=127.0.0.1
# EPICS_CA_AUTO_ADDR_LIST=YES
